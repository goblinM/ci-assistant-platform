# Platform configuration
# CI_ASSISTANT_CONFIG=config.yml
# CI_ASSISTANT_SECRET_DIR=secrets
APP_ENVIRONMENT=development

LLM_API_URL=https://api.example.com/v1
LLM_API_KEY=replace-with-your-api-key
LLM_MODEL=your-model-name
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=2

# RAG retrieval
RETRIEVE_TOP_K=3
RAG_MIN_SCORE=0.25
RAG_CANDIDATE_MULTIPLIER=4
RAG_CONTEXT_MAX_CHARS=6000

# Local embedding cache. The default path is below knowledge.storage_path.
CI_ASSISTANT__KNOWLEDGE__EMBEDDING_CACHE_ENABLED=true
CI_ASSISTANT__KNOWLEDGE__EMBEDDING_CACHE_MAX_ENTRIES=100000

# Optional external Unlimited-OCR service for PDF parsing.
CI_ASSISTANT__KNOWLEDGE__UNLIMITED_OCR__ENABLED=false
CI_ASSISTANT__KNOWLEDGE__UNLIMITED_OCR__BASE_URL=http://unlimited-ocr:10000
CI_ASSISTANT__KNOWLEDGE__UNLIMITED_OCR__MODEL=Unlimited-OCR
CI_ASSISTANT__KNOWLEDGE__UNLIMITED_OCR__TIMEOUT_SECONDS=1200

# Optional Cross-Encoder/BGE backend: disabled, local, or http.
CI_ASSISTANT__KNOWLEDGE__RERANKER__BACKEND=disabled
CI_ASSISTANT__KNOWLEDGE__RERANKER__BASE_URL=http://reranker:8080
CI_ASSISTANT__KNOWLEDGE__RERANKER__ENDPOINT=/rerank
CI_ASSISTANT__KNOWLEDGE__RERANKER__MODEL=BAAI/bge-reranker-v2-m3
CI_ASSISTANT__KNOWLEDGE__RERANKER__TIMEOUT_SECONDS=15
CI_ASSISTANT__KNOWLEDGE__RERANKER__CANDIDATE_MULTIPLIER=4
CI_ASSISTANT__KNOWLEDGE__RERANKER__DEVICE=cpu
CI_ASSISTANT__KNOWLEDGE__RERANKER__BATCH_SIZE=16
CI_ASSISTANT__KNOWLEDGE__RERANKER__MAX_LENGTH=512
CI_ASSISTANT__KNOWLEDGE__RERANKER__LOCAL_FILES_ONLY=false

# Local service
APP_HOST=0.0.0.0
APP_PORT=8080
APP_RELOAD=false
# JSON mapping: API key -> tenant UUID. Use "*" only for the platform admin key.
API_KEYS_JSON={}

# Platform persistence (used by the new ci_assistant package)
POSTGRES_PASSWORD=replace-with-a-strong-local-password
POSTGRES_PORT=15432
DATABASE_URL=postgresql+asyncpg://ci_assistant:replace-with-a-strong-local-password@localhost:15432/ci_assistant
REDIS_URL=redis://localhost:6379/0

# gitlab
GITLAB_BASE_URL=https://gitlab.example.com
GITLAB_PRIVATE_TOKEN=your_gitlab_token
GITLAB_TIMEOUT_SECONDS=20

# GitHub Actions Provider: use a short-lived GitHub App installation token in production.
GITHUB_APP_TOKEN=your_github_app_installation_token
GITHUB_WEBHOOK_SECRET=replace-with-a-strong-webhook-secret
