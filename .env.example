# Platform configuration
# CI_ASSISTANT_CONFIG=config.yml
# CI_ASSISTANT_SECRET_DIR=secrets
APP_ENVIRONMENT=development

LLM_API_URL=https://api.example.com/v1
LLM_API_KEY=replace-with-your-api-key
LLM_MODEL=your-model-name
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=2

# RAG retrieval
RETRIEVE_TOP_K=3
RAG_MIN_SCORE=0.25
RAG_CANDIDATE_MULTIPLIER=4
RAG_CONTEXT_MAX_CHARS=6000

# Local service
APP_HOST=0.0.0.0
APP_PORT=8080
APP_RELOAD=false
# JSON mapping: API key -> tenant UUID. Use "*" only for the platform admin key.
API_KEYS_JSON={}

# Platform persistence (used by the new ci_assistant package)
POSTGRES_PASSWORD=replace-with-a-strong-local-password
POSTGRES_PORT=15432
DATABASE_URL=postgresql+asyncpg://ci_assistant:replace-with-a-strong-local-password@localhost:15432/ci_assistant
REDIS_URL=redis://localhost:6379/0

# gitlab
GITLAB_BASE_URL=https://gitlab.example.com
GITLAB_PRIVATE_TOKEN=your_gitlab_token
GITLAB_TIMEOUT_SECONDS=20
